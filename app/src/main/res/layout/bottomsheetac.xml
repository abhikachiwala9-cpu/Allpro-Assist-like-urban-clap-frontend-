<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardac2"
        android:layout_width="380dp"
        android:layout_height="700dp"
        android:layout_marginTop="10dp"
        app:cardElevation="20dp"
        app:cardCornerRadius="10dp"
        >

        <ImageView
            android:id="@+id/imgclose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/cancel"
            android:layout_gravity="end"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AC &amp; Appliance repair"
            android:textStyle="bold"
            android:textSize="30sp"
            android:layout_margin="10dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appliance repair &amp; Services"
            android:layout_marginLeft="10dp"
           android:layout_marginTop="80dp"
            android:textSize="20sp"
            android:textColor="@color/black"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_margin="10dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.cardview.widget.CardView
                android:layout_width="110dp"
                android:layout_height="130dp"
                app:cardElevation="5dp"
                app:cardCornerRadius="15dp"
                android:layout_marginLeft="5dp"
                >

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="5dp"
                    android:src="@mipmap/ac"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AC Repair &amp; Services"
                    android:textColor="@color/black"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="10dp"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="110dp"
                android:layout_height="130dp"
                app:cardElevation="5dp"
                app:cardCornerRadius="15dp"
                android:layout_marginLeft="10dp"
                >

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="5dp"
                    android:src="@mipmap/washingmachine"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Washing Machine Repair"
                    android:textColor="@color/black"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="10dp"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="110dp"
                android:layout_height="130dp"
                app:cardElevation="5dp"
                app:cardCornerRadius="15dp"
                android:layout_marginLeft="10dp"
                >

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="5dp"
                    android:src="@mipmap/fridge"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refrigator Repair"
                    android:textColor="@color/black"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="10dp"/>

            </androidx.cardview.widget.CardView>


        </LinearLayout>

    </androidx.cardview.widget.CardView>



</LinearLayout>