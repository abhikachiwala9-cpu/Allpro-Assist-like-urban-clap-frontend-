<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:layout_margin="8dp"
    android:backgroundTint="@android:color/white"
    android:backgroundTintMode="src_in"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/service_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AC Service"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/service_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address :31,sumandal society "
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/service_mob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact no : 9998466476 "
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/service_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 549"
                android:textSize="16sp"
                android:textColor="@android:color/darker_gray" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/btn_star_big_on" />

                <TextView
                    android:id="@+id/service_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5"
                    android:layout_marginStart="4dp"
                    android:textColor="@android:color/darker_gray" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/service_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"

            android:contentDescription="Technician servicing an AC unit"

            android:layout_marginStart="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.5" />

    <Button
        android:id="@+id/service_details_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Details"
        android:visibility="gone"
        android:textColor="@android:color/holo_blue_light"
        android:background="?attr/selectableItemBackground"
        android:layout_gravity="center_horizontal" />
</LinearLayout>
