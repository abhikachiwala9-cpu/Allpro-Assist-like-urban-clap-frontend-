<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".activity.NavigationActivity">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />



    <com.nafis.bottomnavigation.NafisBottomNavigation
        android:id="@+id/bnv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:mbn_circleColor="@color/yellow"
        app:mbn_backgroundBottomColor="@color/primary"
        app:mbn_countTypeface="fonts/SourceSansPro-Regular.ttf"
        app:mbn_defaultIconColor="@color/white"
        app:mbn_selectedIconColor="@color/black"
        app:mbn_countBackgroundColor="#ff6f00"
        app:mbn_hasAnimation="true"
        app:mbn_rippleColor="@color/teal_200"
        app:mbn_countTextColor="@color/yellow"
        app:mbn_shadowColor="#1f212121"
        />
</androidx.coordinatorlayout.widget.CoordinatorLayout>